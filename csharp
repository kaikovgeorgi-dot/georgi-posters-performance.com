<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Posters Performance</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#0b0b0b;
    color:white;
}

/* HEADER */
header{
    background:black;
    padding:20px;
    text-align:center;
    border-bottom:2px solid #ff3c00;
}

header h1{
    color:#ff3c00;
    font-size:32px;
}

/* HERO */
.hero{
    padding:80px 20px;
    text-align:center;
    background:linear-gradient(120deg,#ff3c00,#300000);
}

.hero h2{
    font-size:42px;
    margin-bottom:15px;
}

.hero p{
    font-size:18px;
    opacity:0.9;
}

/* POSTERS */
.section{
    padding:60px 20px;
}

.section h2{
    text-align:center;
    color:#ff3c00;
    font-size:32px;
    margin-bottom:40px;
}

.posters-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:30px;
    max-width:1200px;
    margin:auto;
}

.poster-card{
    background:#111;
    border-radius:12px;
    padding:15px;
    text-align:center;
    box-shadow:0 0 20px rgba(255,60,0,0.15);
    transition:0.3s;
}

.poster-card:hover{
    transform:scale(1.03);
    box-shadow:0 0 35px rgba(255,60,0,0.35);
}

.poster-card img{
    width:100%;
    border-radius:10px;
    margin-bottom:15px;
}

.poster-card h3{
    margin-bottom:12px;
}

.btn{
    display:inline-block;
    background:#ff3c00;
    color:white;
    padding:10px 18px;
    border-radius:6px;
    text-decoration:none;
    font-weight:bold;
    transition:0.3s;
}

.btn:hover{
    background:#ff5a2a;
}

/* ORDER */
#order{
    background:#0f0f0f;
    padding:60px 20px;
}

form{
    max-width:400px;
    margin:auto;
    background:#111;
    padding:25px;
    border-radius:12px;
}

form h3{
    text-align:center;
    color:#ff3c00;
    margin-bottom:20px;
}

form input, form button{
    width:100%;
    padding:12px;
    margin-bottom:10px;
    border-radius:6px;
    border:none;
}

form button{
    background:#ff3c00;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

form button:hover{
    background:#ff5a2a;
}

/* FOOTER */
footer{
    background:black;
    text-align:center;
    padding:20px;
    margin-top:50px;
    font-size:14px;
    opacity:0.7;
}
</style>
</head>

<body>

<header>
    <h1>Posters Performance</h1>
</header>

<section class="hero">
    <h2>Performance Posters</h2>
    <p>Премиум постери за коли • Тунинг • Performance култура</p>
</section>

<section class="section" id="posters">
    <h2>Нашите постери</h2>

    <div class="posters-grid">

        <div class="poster-card">
            <img src="images/poster1.png" alt="Poster 1">
            <h3>BMW M1000RR</h3>
            <a href="#order" class="btn">Поръчай</a>
        </div>

        <div class="poster-card">
            <img src="images/poster2.png" alt="Poster 2">
            <h3>Dimitrov BMW</h3>
            <a href="#order" class="btn">Поръчай</a>
        </div>

        <div class="poster-card">
            <img src="images/poster3.png" alt="Poster 3">
            <h3>RS7 Performance</h3>
            <a href="#order" class="btn">Поръчай</a>
        </div>

    </div>
</section>

<section id="order">
    <form action="https://formsubmit.co/georgi_kaykov@abv.bg" method="POST">
        <input type="hidden" name="_subject" value="Нова поръчка от сайта">
        <input type="hidden" name="_captcha" value="false">

        <h3>Поръчка на постер</h3>

        <input type="text" name="name" placeholder="Име и фамилия" required>
        <input type="tel" name="phone" placeholder="Телефон" required>
        <input type="email" name="email" placeholder="Имейл" required>
        <input type="text" name="address" placeholder="Адрес за доставка" required>
        <input type="text" name="product" placeholder="Име на постера" required>

        <button type="submit">Поръчай</button>
    </form>
</section>

<footer>
    © 2026 Posters Performance | All rights reserved
</footer>

</body>
</html>
